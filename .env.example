# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and only read locally.

# Required — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the default model. Defaults to Claude Sonnet 4.6.
# AUTOCAM_MODEL=claude-sonnet-4-6

# Optional — path where AutoCam caches previews / downloaded model weights.
# Defaults to ~/.cache/autocam
# AUTOCAM_CACHE_DIR=
